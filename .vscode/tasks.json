{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Gradle: assemble",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew",
      "args": ["assemble", "--no-daemon"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$javac"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true
      }
    },
    {
      "label": "Gradle: clean jpackage",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew",
      "args": ["clean", "jpackage", "--no-daemon"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": ["$javac"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}
